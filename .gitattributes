# cross-platform line-ending consistency for snapshots, scripts and markdown
# (Windows contributors work through WSL2; the Windows CI job checks out with
# native git where core.autocrlf=true, and dprint expects LF in markdown)
*.snap text eol=lf
*.sh text eol=lf
justfile text eol=lf
*.md text eol=lf
# the corpus digest hashes fixture bytes raw — pin LF so the identical
# committed corpus hashes to the same set_digest on every platform
# (fixtures are text-only by construction)
evals/** text eol=lf
